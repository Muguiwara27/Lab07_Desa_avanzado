<UserControl x:Class="Presentacion.Vistas.ProductosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <!-- PANEL IZQUIERDO: CATÁLOGO Y LISTADO DE PRODUCTOS -->
        <Grid Grid.Column="0" Margin="0,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Barra de herramientas de búsqueda y filtros -->
                <RowDefinition Height="Auto"/> <!-- Banner de Papelera (si está activo) -->
                <RowDefinition Height="*"/>    <!-- DataGrid de productos -->
                <RowDefinition Height="Auto"/> <!-- Barra de estado de registros -->
            </Grid.RowDefinitions>

            <!-- BARRA DE HERRAMIENTAS -->
            <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="14,10" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="🔍" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="txtBuscar" Grid.Column="1" VerticalAlignment="Center" TextChanged="Buscar_Changed"
                             ToolTip="Buscar por nombre, descripción o categoría"/>

                    <ToggleButton x:Name="btnPapelera" Grid.Column="2" Margin="12,0,0,0" Padding="12,6"
                                  Content="🗑️ Ver Papelera" Click="Papelera_Click" Cursor="Hand"
                                  FontWeight="SemiBold" FontSize="12.5"/>

                    <TextBlock x:Name="lblModo" Grid.Column="3" Margin="14,0,0,0" VerticalAlignment="Center" 
                               FontWeight="Bold" Foreground="{StaticResource DangerBrush}" FontSize="12.5"/>

                    <Border Grid.Column="4" Background="#F1F5F9" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                        <TextBlock x:Name="lblContador" Text="0 registros" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}"/>
                    </Border>
                </Grid>
            </Border>

            <!-- BANNER DE MODO PAPELERA -->
            <Border x:Name="bannerPapelera" Grid.Row="1" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" 
                    CornerRadius="6" Padding="12,8" Margin="0,0,0,12" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚠️" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="MODO PAPELERA: Mostrando productos eliminados lógicamente. Seleccione un elemento para restaurarlo." 
                               FontWeight="SemiBold" Foreground="#991B1B" VerticalAlignment="Center" FontSize="12"/>
                </StackPanel>
            </Border>

            <!-- TABLA DE PRODUCTOS (DATAGRID) -->
            <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="0" ClipToBounds="True">
                <DataGrid x:Name="grid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                          SelectionChanged="Grid_SelectionChanged" CanUserAddRows="False" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding IdProducto}" Width="50"/>
                        <DataGridTextColumn Header="Nombre del Producto" Binding="{Binding Nombre}" Width="1.5*" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="Categoría" Binding="{Binding Categoria}" Width="120"/>
                        <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="2*"/>
                        <DataGridTextColumn Header="Precio" Binding="{Binding Precio, StringFormat=S/ {0:N2}}" Width="95"/>
                        <DataGridTextColumn Header="Stock" Binding="{Binding Stock}" Width="75"/>
                        <DataGridTextColumn x:Name="colFecha" Header="Eliminado el" Binding="{Binding FechaEliminacion, StringFormat=dd/MM/yyyy HH:mm}" Width="135" Visibility="Collapsed"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- PANEL DERECHO: FORMULARIO DE GESTIÓN Y EDICIÓN -->
        <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="18">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Encabezado de la Tarjeta del Formulario -->
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,12" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock x:Name="lblTituloForm" Text="➕ Nuevo Producto" FontSize="15" FontWeight="Bold" Foreground="{StaticResource DarkTextBrush}"/>
                            <TextBlock Text="Complete los datos del producto para registrar o actualizar." FontSize="11.5" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Campos del Formulario -->
                    <TextBlock Text="Nombre del Producto *" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtNombre" Margin="0,0,0,12"/>

                    <TextBlock Text="Categoría *" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,4"/>
                    <ComboBox x:Name="cboCategoria" DisplayMemberPath="Nombre" SelectedValuePath="IdCategoria" Margin="0,0,0,12"/>

                    <TextBlock Text="Descripción" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtDescripcion" Height="65" TextWrapping="Wrap" AcceptsReturn="True" 
                             VerticalContentAlignment="Top" Padding="8,6" Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Precio (S/) *" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtPrecio"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Stock *" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtStock"/>
                        </StackPanel>
                    </Grid>

                    <!-- Acciones del Formulario -->
                    <Button x:Name="btnGuardar" Style="{StaticResource PrimaryButtonStyle}" Content="💾 Guardar Producto" Click="Guardar_Click" Margin="0,0,0,8"/>
                    <Button x:Name="btnNuevo" Style="{StaticResource SecondaryButtonStyle}" Content="🧹 Limpiar / Nuevo" Click="Nuevo_Click" Margin="0,0,0,8"/>
                    <Button x:Name="btnEliminar" Style="{StaticResource DangerButtonStyle}" Content="🗑️ Eliminar Producto" Click="Eliminar_Click" Margin="0,0,0,8"/>
                    <Button x:Name="btnRestaurar" Style="{StaticResource SuccessButtonStyle}" Content="♻️ Restaurar al Catálogo" Click="Restaurar_Click" Visibility="Collapsed" Margin="0,0,0,8"/>

                    <!-- Mensaje de ayuda contextual -->
                    <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,8,0,0">
                        <TextBlock Text="💡 Ingrese los datos obligatorios (*) antes de presionar Guardar." FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
